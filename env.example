# Required for Gemini-backed features.
# Get a key from Google AI Studio.
GEMINI_API_KEY=YOUR_API_KEY_HERE

# Current model used by this project. Change if your account exposes another model.
GEMINI_MODEL=gemini-3.8-flash

# Local concept-explanation model from the project documentation.
# Set false if you do not want the local Transformers model downloaded.
ENABLE_LOCAL_EXPLANATION=true
LOCAL_EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M

# Maximum user text sent to Gemini.
MAX_INPUT_CHARS=20000
